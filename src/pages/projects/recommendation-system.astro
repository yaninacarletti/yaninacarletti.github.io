---
import Layout from "../../layouts/Layout.astro";
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectSummary from "../../components/ProjectSummary.astro";

const project = {

    title: "Recommendation System",

    subtitle:
       "Delivering personalized recommendations through collaborative and content-based filtering.",

    category: "Recommendation Systems",

    domain: "SaaS",

    role: "Data Scientist",

    duration: "Personal Project",

    status: "Completed",

    technologies: [
        "Python",
        "Pandas",
        "Scikit-Learn",
        "Collaborative Filtering",
        "Content-Based",
        "Matplotlib"
    ]

};
---

<Layout>

<main class="project-page">

    <!-- ========================= -->
    <!-- Hero -->
    <!-- ========================= -->

    <ProjectHero
        category={project.category}
        title={project.title}
        subtitle={project.subtitle}
        tags={project.technologies}
    />    

    <!-- ========================= -->
    <!-- Business Context -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>

                Business Context

            </h2>

            <p>

                Personalized recommendation systems help users discover relevant
                products and content while increasing engagement, customer
                satisfaction and conversion rates. They are a fundamental component
                of modern digital platforms.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Challenge -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container narrow">

            <h2>

                Challenge

            </h2>

            <p>

                The objective was to recommend relevant items based on historical
                user interactions while dealing with sparse data, user preferences
                and item similarities.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Solution -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>
                Solution
            </h2>

            <p>

                A recommendation workflow was developed combining collaborative
                filtering, content-based techniques and similarity measures to
                generate personalized recommendations for each user.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Machine Learning Pipeline -->
    <!-- ========================= -->

    <section class="pipeline-section">

        <div class="container">

            <h2 class="section-title">
                Machine Learning Pipeline
            </h2>

            <p class="section-subtitle">
                End-to-end workflow followed during the development of the project.
            </p>

            <div class="pipeline">

                <div class="pipeline-step">
                    <span>1</span>
                    <h3>User Interaction Data</h3>
                    <p>Collecting user-item interaction history.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>2</span>
                    <h3>Cleaning</h3>
                    <p>Removing duplicates and invalid records.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>3</span>
                    <h3>Feature Engineering</h3>
                    <p>Building user and item representations.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>4</span>
                    <h3>Similarity Matrix</h3>
                    <p>Computing similarities between users or items.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>5</span>
                    <h3>Collaborative Filtering</h3>
                    <p>Learning preferences from historical interactions.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>6</span>
                    <h3>Content-Based Filtering</h3>
                    <p>Recommending similar items using their attributes.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>7</span>
                    <h3>Recommendation Generation</h3>
                    <p>Producing personalized recommendation lists.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>8</span>
                    <h3>Performance Evaluation</h3>
                    <p>Assessing recommendation quality using ranking metrics.</p>
                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Tech Stack -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Technology Stack
            </h2>

            <div class="stack-grid">

                <article class="stack-card">

                    <h3>Programming</h3>

                    <div class="stack-tags">

                        <span>Python</span>
                        <span>Pandas</span>
                        <span>NumPy</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Machine Learning</h3>

                    <div class="stack-tags">

                        <span>Scikit-Learn</span>
                        <span>Collaborative Filtering</span>
                        <span>Cosine Similarity</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Visualization</h3>

                    <div class="stack-tags">

                        <span>Matplotlib</span>
                        <span>Seaborn</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Development</h3>

                    <div class="stack-tags">

                        <span>Git</span>
                        <span>GitHub</span>
                        <span>Jupyter Notebook</span>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Key Outcomes -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container">

            <h2 class="section-title">
                Key Outcomes
            </h2>

            <div class="results-grid">

                <div class="result-card">

                    <h3>Personalized Recommendations</h3>

                    <p>

                        Recommendation engine capable of generating personalized
                        item suggestions based on user preferences.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Collaborative Filtering</h3>

                    <p>

                        User behavior leveraged to discover hidden preference
                        patterns and improve recommendation quality.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Content-Based Filtering</h3>

                    <p>

                        Item characteristics incorporated to recommend products
                        with similar attributes.

                    </p>

                </div>

                <div class="result-card">

                    <h3>User Experience</h3>

                    <p>

                        Recommendation workflow designed to increase engagement
                        and customer satisfaction.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Visual Results -->
    <!-- ========================= -->

    <section class="content-section alternate">
        <div class="container">

            <h2 class="section-title">Visual Results</h2>

            <p class="section-subtitle">
                Conceptual visualizations illustrating the main stages
                and mechanisms of the recommendation system.
            </p>

            <div class="gallery-grid">

                <!-- 01 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Recommendation Pipeline image"
                        data-lightbox-image="/images/projects/recommendation-system/01-recommendation-pipeline.png"
                        data-lightbox-alt="Conceptual recommendation system pipeline"
                    >
                        <img
                            src="/images/projects/recommendation-system/01-recommendation-pipeline.png"
                            alt="Conceptual recommendation system pipeline"
                            loading="lazy"
                        />
                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            01
                        </span>

                        <h3>Recommendation Pipeline</h3>

                        <p>
                            Conceptual overview of the recommendation workflow,
                            from user and item data to the generation of personalized recommendations.
                        </p>

                    </div>

                </article>


                <!-- 02 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View User–Item Interactions image"
                        data-lightbox-image="/images/projects/recommendation-system/02-user-item-interactions.png"
                        data-lightbox-alt="Conceptual representation of user-item interactions"
                    >
                        <img
                            src="/images/projects/recommendation-system/02-user-item-interactions.png"
                            alt="Conceptual representation of user-item interactions"
                            loading="lazy"
                        />
                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            02
                        </span>

                        <h3>User–Item Interactions</h3>

                        <p>
                            Conceptual representation of the interactions between users
                            and items that provide the basis for learning preferences.
                        </p>

                    </div>

                </article>


                <!-- 03 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Personalized Recommendations image"
                        data-lightbox-image="/images/projects/recommendation-system/03-personalized-recommendations.png"
                        data-lightbox-alt="Conceptual personalized recommendation output"
                    >
                        <img
                            src="/images/projects/recommendation-system/03-personalized-recommendations.png"
                            alt="Conceptual personalized recommendation output"
                            loading="lazy"
                        />
                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            03
                        </span>

                        <h3>Personalized Recommendations</h3>

                        <p>
                            Conceptual example of how user preferences can be translated
                            into personalized item recommendations.
                        </p>

                    </div>

                </article>


                <!-- 04 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Top-N Recommendation Ranking image"
                        data-lightbox-image="/images/projects/recommendation-system/04-top-n-recommendation-ranking.png"
                        data-lightbox-alt="Conceptual Top-N recommendation ranking"
                    >
                        <img
                            src="/images/projects/recommendation-system/04-top-n-recommendation-ranking.png"
                            alt="Conceptual Top-N recommendation ranking"
                            loading="lazy"
                        />
                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            04
                        </span>

                        <h3>Top-N Recommendation Ranking</h3>

                        <p>
                            Conceptual representation of ranking candidate items
                            to produce a Top-N recommendation list for each user.
                        </p>

                    </div>

                </article>

            </div>

        </div>
    </section>

    <div
        id="image-lightbox"
        class="image-lightbox"
        aria-hidden="true"
    >

        <div class="lightbox-content">

            <button
                class="lightbox-close"
                type="button"
                aria-label="Close image"
            >
                ×
            </button>

            <img
                id="lightbox-image"
                src=""
                alt=""
            />

        </div>

    </div>

    <script>
        const lightbox = document.getElementById('image-lightbox');
        const lightboxImage = document.getElementById('lightbox-image');
        const lightboxClose = document.querySelector('.lightbox-close');
        const galleryButtons = document.querySelectorAll('.gallery-image-button');

        function openLightbox(imageSrc, imageAlt) {

            if (!lightbox || !lightboxImage) return;

            lightboxImage.src = imageSrc;
            lightboxImage.alt = imageAlt;

            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden', 'false');

            document.body.classList.add('lightbox-open');

        }

        function closeLightbox() {

            if (!lightbox || !lightboxImage) return;

            lightbox.classList.remove('is-open');
            lightbox.setAttribute('aria-hidden', 'true');

            document.body.classList.remove('lightbox-open');

            lightboxImage.src = '';
            lightboxImage.alt = '';

        }

        galleryButtons.forEach((button) => {

            button.addEventListener('click', () => {

                const imageSrc = button.getAttribute('data-lightbox-image');
                const imageAlt = button.getAttribute('data-lightbox-alt');

                if (imageSrc && imageAlt) {
                    openLightbox(imageSrc, imageAlt);
                }

            });

        });

        lightboxClose?.addEventListener('click', closeLightbox);

        lightbox?.addEventListener('click', (event) => {

            if (event.target === lightbox) {
                closeLightbox();
            }

        });

        document.addEventListener('keydown', (event) => {

            if (event.key === 'Escape') {
                closeLightbox();
            }

        });
    </script>

    <!-- ========================= -->
    <!-- Project Summary -->
    <!-- ========================= -->

        <ProjectSummary
        domain="E-commerce & Personalization"
        problemType="Recommendation System"
        role="End-to-End Data Scientist"
        duration="Personal Project"
        technologies={project.technologies}
    />

    <!-- ========================= -->
    <!-- GitHub CTA -->
    <!-- ========================= -->

    <section class="github-section">

        <div class="container">

            <div class="github-card">

                <h2>
                    Explore the Complete Project
                </h2>

                <p>

                    Discover the recommendation algorithms, similarity techniques and personalization workflow implemented in this project.

                </p>

                <a
                    href="https://github.com/yaninacarletti/Recomendador"
                    target="_blank"
                    class="primary-btn"
                >
                    View on GitHub →
                </a>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Next Project -->
    <!-- ========================= -->

    <section class="next-project">

        <div class="container">

            <span>
                Next Case Study
            </span>

            <h2>

                ETL Airplane Tickets

            </h2>

            <p>

                Designing automated ETL pipelines for collecting, transforming and storing airline pricing data.
            </p>

            <a
                href="/projects/etl-airplane-tickets"
                class="secondary-btn"
            >
                Read Next Project →
            </a>

        </div>

    </section>

</main>

</Layout>

<style>

.project-page{
    padding-top:90px;
}

/* ===========================
   Hero
=========================== */




/* ===========================
   Summary
=========================== */

.summary{
    padding:4rem 0;
}

.summary-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:1.2rem;
}

.summary-item{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:16px;
    padding:1.5rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.summary-item:hover{
    transform:translateY(-6px);
    box-shadow:var(--shadow-md);
}

.summary-item span{
    display:block;
    color:var(--text-light);
    font-size:.82rem;
    margin-bottom:.6rem;
}

.summary-item strong{
    font-size:1rem;
}

/* ===========================
   Generic Sections
=========================== */

.content-section{
    padding:5rem 0;
}

.alternate{
    background:var(--surface);
}

.narrow{
    max-width:820px;
}

.section-title{
    font-size:2rem;
    margin-bottom:1rem;
}

.section-subtitle{
    color:var(--text-light);
    margin-bottom:3rem;
    max-width:760px;
}

.content-section p{
    color:var(--text-light);
    line-height:1.9;
    margin-bottom:1.5rem;
}

.challenge-list{
    margin-top:2rem;
    padding-left:1.25rem;
}

.challenge-list li{
    margin-bottom:1rem;
    color:var(--text-light);
}

/* ===========================
   Pipeline
=========================== */

.pipeline{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:1rem;
    align-items:start;
    margin-top:3rem;
}

.pipeline-step{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:1.4rem;
    text-align:center;
    position:relative;
    transition:.3s;
    box-shadow:var(--shadow-sm);
}

.pipeline-step:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.pipeline-step span{
    display:inline-flex;
    width:42px;
    height:42px;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:var(--primary);
    color:white;
    font-weight:700;
    margin-bottom:1rem;
}

.pipeline-step h3{
    margin-bottom:.8rem;
    font-size:1rem;
}

.pipeline-step p{
    font-size:.92rem;
    margin:0;
}

.pipeline-arrow{
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:2rem;
    color:var(--primary);
}

/* ===========================
   Stack
=========================== */

.stack-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:1.5rem;
}

.stack-card{
    background: var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.stack-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.stack-card h3{
    margin-bottom:1.25rem;
}

.stack-tags{
    display:flex;
    flex-wrap:wrap;
    gap:.8rem;
}

.stack-tags span{
    padding:.45rem .9rem;
    border-radius:999px;
    background:var(--surface);
    border:1px solid var(--border);
    color:var(--primary);
    font-size:.85rem;
}

/* ===========================
   Results
=========================== */

.results-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:1.5rem;
}

.result-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.result-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.result-card h3{
    margin-bottom:1rem;
}

.result-card p{
    margin:0;
}

/* ===========================
   Gallery
=========================== */

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:2rem;
    margin-top:3rem;
}

.gallery-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--shadow-sm);
    transition:all .3s ease;
}

.gallery-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.gallery-image-button{
    display:block;
    width:100%;
    padding:0;
    margin:0;
    border:0;
    background:var(--surface);
    cursor:pointer;
    overflow:hidden;
}

.gallery-image-button img{
    display:block;
    width:100%;
    height:300px;
    object-fit:contain;
    background:var(--surface);
    transition:transform .35s ease;
}

.gallery-image-button:hover img{
    transform:scale(1.025);
}

.gallery-content{
    padding:1.5rem;
}

.gallery-number{
    display:block;
    margin-bottom:1.5rem;
    color:var(--primary);
    font-size:.8rem;
    font-weight:700;
    letter-spacing:.08em;
}

.gallery-content h3{
    margin:0 0 .75rem;
    font-size:1.05rem;
}

.gallery-content p{
    margin:0;
    color:var(--text-light);
    line-height:1.7;
}

/* ===========================
   Lightbox
=========================== */

.image-lightbox{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:2rem;
    background:rgba(0,0,0,.88);
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    transition:opacity .3s ease, visibility .3s ease;
}

.image-lightbox.is-open{
    opacity:1;
    visibility:visible;
    pointer-events:auto;
}

.lightbox-content{
    position:relative;
    max-width:95vw;
    max-height:90vh;
    display:flex;
    align-items:center;
    justify-content:center;
}

.lightbox-content img{
    display:block;
    max-width:95vw;
    max-height:90vh;
    width:auto;
    height:auto;
    object-fit:contain;
    border-radius:12px;
    box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.lightbox-close{
    position:fixed;
    top:1.5rem;
    right:1.5rem;
    z-index:10000;
    width:44px;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(255,255,255,.35);
    border-radius:50%;
    background:rgba(255,255,255,.1);
    color:white;
    font-size:1.8rem;
    line-height:1;
    cursor:pointer;
    transition:all .25s ease;
}

.lightbox-close:hover{
    background:white;
    color:var(--primary);
}

body.lightbox-open{
    overflow:hidden;
}

/* ===========================
   Gallery Responsive
=========================== */

@media (max-width:768px){

    .gallery-grid{
        grid-template-columns:1fr;
    }

    .gallery-image-button img{
        height:260px;
    }

    .gallery-content{
        padding:1.35rem;
    }

    .image-lightbox{
        padding:1rem;
    }

    .lightbox-content img{
        max-width:94vw;
        max-height:82vh;
    }

    .lightbox-close{
        top:1rem;
        right:1rem;
    }

}

/* ===========================
   GitHub CTA
=========================== */

.github-section{
    padding:6rem 0;
}

.github-card{
    max-width:900px;
    margin:auto;
    text-align:center;
    background:linear-gradient(
        135deg,
        var(--primary),
        #4f46e5
    );
    color:white;
    padding:4rem 3rem;
    border-radius:28px;
    box-shadow:var(--shadow-md);
}

.github-card h2{
    color:white;
    margin-bottom:1rem;
    font-size:2.2rem;
}

.github-card p{
    color:rgba(255,255,255,.88);
    max-width:650px;
    margin:0 auto 2rem;
    line-height:1.8;
}

.github-card .primary-btn{
    background:white;
    color:var(--primary);
}

.github-card .primary-btn:hover{
    transform:translateY(-3px);
}

/* ===========================
   Next Project
=========================== */

.next-project{
    padding:5rem 0 6rem;
    text-align:center;
    border-top:1px solid var(--border);
}

.next-project span{
    color:var(--primary);
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    font-size:.8rem;
}

.next-project h2{
    margin:1rem 0;
    font-size:2.5rem;
}

.next-project p{
    max-width:650px;
    margin:0 auto 2rem;
    color:var(--text-light);
    line-height:1.8;
}

/* ===========================
   Buttons
=========================== */

.primary-btn,
.secondary-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.95rem 1.7rem;
    border-radius:12px;
    font-weight:600;
    text-decoration:none;
    transition:all .3s ease;
    cursor:pointer;
}

.primary-btn{
    background:var(--primary);
    color:white;
}

.primary-btn:hover{
    transform:translateY(-3px);
    box-shadow:var(--shadow-md);
}

.secondary-btn{
    border:1px solid var(--border);
    color:var(--text);
    background:var(--surface);
}

.secondary-btn:hover{
    background:var(--primary);
    color:white;
    border-color:var(--primary);
}

/* ===========================
   Animations
=========================== */

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.project-hero,
.summary,
.content-section,
.github-section,
.next-project{

    animation:fadeUp .8s ease both;

}

/* ===========================
   Responsive
=========================== */

@media (max-width:1100px){

    .pipeline{
        grid-template-columns:repeat(3,1fr);
    }

    .pipeline-arrow{
        display:none;
    }

}

@media (max-width:768px){

    .project-hero{
