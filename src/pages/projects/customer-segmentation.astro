
---
import Layout from "../../layouts/Layout.astro";
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectSummary from "../../components/ProjectSummary.astro";

const project = {

    title: "Customer Segmentation",

    subtitle:
        "Discovering customer groups through Unsupervised Machine Learning.",

    category: "Clustering",

    domain: "Retail & Marketing",

    role: "End-to-End Data Scientist",

    duration: "Personal Project",

    status: "Completed",

    technologies: [
        "Python",
        "Pandas",
        "Scikit-Learn",
        "PCA",
        "K-Means",
        "Matplotlib"
    ]

};
---

<Layout>

<main class="project-page">

    <!-- ========================= -->
    <!-- Hero -->
    <!-- ========================= -->

    <ProjectHero
        category={project.category}
        title={project.title}
        subtitle={project.subtitle}
        tags={project.technologies}
    />
    

    <!-- ========================= -->
    <!-- Business Context -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>

                Business Context

            </h2>

            <p>

                Companies frequently accumulate large amounts of customer data but struggle to
                understand how different customer profiles behave.

            </p>

            <p>

                Customer Segmentation enables organizations to identify homogeneous customer
                groups, making it possible to design personalized marketing campaigns,
                improve customer retention and optimize business strategies.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Challenge -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container narrow">

            <h2>

                Challenge

            </h2>

            <p>

                Unlike supervised learning problems, customer segmentation has no predefined
                labels. The objective is to discover meaningful patterns hidden inside the data.

            </p>

            <ul class="challenge-list">

                <li>Cleaning inconsistent records.</li>

                <li>Feature engineering.</li>

                <li>Feature scaling.</li>

                <li>Dimensionality reduction using PCA.</li>

                <li>Selecting the optimal number of clusters.</li>

                <li>Interpreting clusters from a business perspective.</li>

            </ul>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Solution -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>
                Solution
            </h2>

            <p>

                An end-to-end clustering workflow was developed to transform raw customer
                data into actionable business insights.

            </p>

            <p>

                The project combines exploratory analysis, dimensionality reduction and
                unsupervised Machine Learning to identify meaningful customer segments that
                can support marketing and retention strategies.

            </p>

       
        </div>

    </section>

    <!-- ========================= -->
    <!-- Machine Learning Pipeline -->
    <!-- ========================= -->

    <section class="pipeline-section">

        <div class="container">

            <h2 class="section-title">
                Machine Learning Pipeline
            </h2>

            <p class="section-subtitle">
                End-to-end workflow followed during the development of the project.
            </p>

            <div class="pipeline">

                <div class="pipeline-step">
                    <span>1</span>
                    <h3>Raw Customer Data</h3>
                    <p>Collecting customer demographic, behavioral and transactional information from the original dataset.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>2</span>
                    <h3>Cleaning</h3>
                    <p>Handling missing values, duplicates and inconsistent records to improve data quality.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>3</span>
                    <h3>Feature Engineering</h3>
                    <p>Creating meaningful variables that better represent customer purchasing behavior.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>4</span>
                    <h3>Feature Scaling</h3>
                    <p>Standardizing numerical features to ensure fair distance calculations during clustering.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>5</span>
                    <h3>PCA</h3>
                    <p>Reducing dimensionality while preserving the most relevant information for visualization and clustering.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>6</span>
                    <h3>K-Means</h3>
                    <p>Grouping customers into homogeneous clusters based on similarities in their behavior.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>7</span>
                    <h3>Cluster Analysis</h3>
                    <p>Analyzing each cluster to identify distinctive characteristics and business opportunities.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>8</span>
                    <h3>Business Insights</h3>
                    <p>Translating clustering results into actionable marketing, retention and customer engagement strategies.</p>
                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Tech Stack -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Technology Stack
            </h2>

            <div class="stack-grid">

                <article class="stack-card">

                    <h3>Programming</h3>

                    <div class="stack-tags">

                        <span>Python</span>
                        <span>Pandas</span>
                        <span>NumPy</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Machine Learning</h3>

                    <div class="stack-tags">

                        <span>Scikit-Learn</span>
                        <span>K-Means</span>
                        <span>PCA</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Visualization</h3>

                    <div class="stack-tags">

                        <span>Matplotlib</span>
                        <span>Seaborn</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Development</h3>

                    <div class="stack-tags">

                        <span>Git</span>
                        <span>GitHub</span>
                        <span>Jupyter Notebook</span>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Key Outcomes -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container">

            <h2 class="section-title">
                Key Outcomes
            </h2>

            <div class="results-grid">

                <div class="result-card">

                    <h3>Customer Clustering</h3>

                    <p>

                        Customers were grouped into homogeneous segments using
                        unsupervised Machine Learning techniques.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Dimensionality Reduction</h3>

                    <p>

                        Principal Component Analysis (PCA) simplified the feature
                        space while preserving the most relevant information.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Behavior Analysis</h3>

                    <p>

                        Each cluster was analyzed to identify distinctive customer
                        behaviors and purchasing patterns.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Business Insights</h3>

                    <p>

                        The identified segments can support personalized marketing,
                        customer retention and strategic decision-making.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Visual Results -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Visual Results
            </h2>

            <p class="section-subtitle">
                Visualizations prepared to illustrate customer segmentation and cluster interpretation.
            </p>

            <div class="gallery-grid">

                <div class="gallery-card">

                    <div class="image-placeholder">
                        PCA Projection
                    </div>

                    <h3>Cluster Projection</h3>

                    <p>

                        Two-dimensional visualization of customer segments using
                        Principal Component Analysis.

                    </p>

                </div>

                <div class="gallery-card">

                    <div class="image-placeholder">
                        Elbow Method
                    </div>

                    <h3>Optimal Number of Clusters</h3>

                    <p>

                        Identification of the optimal number of clusters using the
                        Elbow Method.

                    </p>

                </div>

                <div class="gallery-card">

                    <div class="image-placeholder">
                        Cluster Profiles
                    </div>

                    <h3>Segment Characteristics</h3>

                    <p>

                        Comparison of customer behavior across the discovered
                        clusters.

                    </p>

                </div>

                <div class="gallery-card">

                    <div class="image-placeholder">
                        Business Dashboard
                    </div>

                    <h3>Business Insights</h3>

                    <p>

                        Executive dashboard summarizing customer segments and
                        strategic recommendations.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Project Summary -->
    <!-- ========================= -->
    
    <ProjectSummary
        domain="Retail & Marketing"
        problemType="Customer Clustering"
        role="End-to-End Data Scientist"
        duration="Personal Project"
        technologies={project.technologies}
    />

    <!-- ========================= -->
    <!-- GitHub CTA -->
    <!-- ========================= -->

    <section class="github-section">

        <div class="container">

            <div class="github-card">

                <h2>
                    Explore the Complete Project
                </h2>

                <p>

                    Explore the complete clustering workflow, feature engineering process and business interpretation developed in this project.

                </p>

                <a
                    href="https://github.com/yaninacarletti/Customer-Segmentation"
                    target="_blank"
                    class="primary-btn"
                >
                    View on GitHub →
                </a>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Next Project -->
    <!-- ========================= -->

    <section class="next-project">

        <div class="container">

            <span>
                Next Case Study
            </span>

            <h2>

                Sales Forecasting

            </h2>

            <p>

                Discover how unsupervised learning was applied to identify
                customer groups and support marketing strategies.

            </p>

            <a
                href="/projects/forecasting"
                class="secondary-btn"
            >
                Read Next Project →
            </a>

        </div>

    </section>

</main>

</Layout>

<style>

.project-page{
    padding-top:90px;
}

/* ===========================
   Hero
=========================== */




/* ===========================
   Summary
=========================== */

.summary{
    padding:4rem 0;
}

.summary-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:1.2rem;
}

.summary-item{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:16px;
    padding:1.5rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.summary-item:hover{
    transform:translateY(-6px);
    box-shadow:var(--shadow-md);
}

.summary-item span{
    display:block;
    color:var(--text-light);
    font-size:.82rem;
    margin-bottom:.6rem;
}

.summary-item strong{
    font-size:1rem;
}

/* ===========================
   Generic Sections
=========================== */

.content-section{
    padding:5rem 0;
}

.alternate{
    background:var(--surface);
}

.narrow{
    max-width:820px;
}

.section-title{
    font-size:2rem;
    margin-bottom:1rem;
}

.section-subtitle{
    color:var(--text-light);
    margin-bottom:3rem;
    max-width:760px;
}

.content-section p{
    color:var(--text-light);
    line-height:1.9;
    margin-bottom:1.5rem;
}

.challenge-list{
    margin-top:2rem;
    padding-left:1.25rem;
}

.challenge-list li{
    margin-bottom:1rem;
    color:var(--text-light);
}

/* ===========================
   Pipeline
=========================== */

.pipeline{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:1rem;
    align-items:start;
    margin-top:3rem;
}

.pipeline-step{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:1.4rem;
    text-align:center;
    position:relative;
    transition:.3s;
    box-shadow:var(--shadow-sm);
}

.pipeline-step:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.pipeline-step span{
    display:inline-flex;
    width:42px;
    height:42px;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:var(--primary);
    color:white;
    font-weight:700;
    margin-bottom:1rem;
}

.pipeline-step h3{
    margin-bottom:.8rem;
    font-size:1rem;
}

.pipeline-step p{
    font-size:.92rem;
    margin:0;
}

.pipeline-arrow{
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:2rem;
    color:var(--primary);
}

/* ===========================
   Stack
=========================== */

.stack-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:1.5rem;
}

.stack-card{
    background: var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.stack-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.stack-card h3{
    margin-bottom:1.25rem;
}

.stack-tags{
    display:flex;
    flex-wrap:wrap;
    gap:.8rem;
}

.stack-tags span{
    padding:.45rem .9rem;
    border-radius:999px;
    background:rgba(99,102,241,.08);
    color:var(--primary);
    font-size:.85rem;
}

/* ===========================
   Results
=========================== */

.results-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:1.5rem;
}

.result-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.result-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.result-card h3{
    margin-bottom:1rem;
}

.result-card p{
    margin:0;
}

/* ===========================
   Gallery
=========================== */

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:2rem;
    margin-top:3rem;
}

.gallery-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--shadow-sm);
    transition:all .3s ease;
}

.gallery-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.image-placeholder{
    height:220px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(
        135deg,
        rgba(99,102,241,.08),
        rgba(99,102,241,.18)
    );
    color:var(--primary);
    font-weight:700;
    letter-spacing:.05em;
    border-bottom:1px solid var(--border);
}

.gallery-card h3{
    padding:1.5rem 1.5rem .5rem;
    margin:0;
}

.gallery-card p{
    padding:0 1.5rem 1.5rem;
    margin:0;
    color:var(--text-light);
    line-height:1.7;
}

/* ===========================
   GitHub CTA
=========================== */

.github-section{
    padding:6rem 0;
}

.github-card{
    max-width:900px;
    margin:auto;
    text-align:center;
    background:linear-gradient(
        135deg,
        var(--primary),
        #4f46e5
    );
    color:white;
    padding:4rem 3rem;
    border-radius:28px;
    box-shadow:var(--shadow-md);
}

.github-card h2{
    color:white;
    margin-bottom:1rem;
    font-size:2.2rem;
}

.github-card p{
    color:rgba(255,255,255,.88);
    max-width:650px;
    margin:0 auto 2rem;
    line-height:1.8;
}

.github-card .primary-btn{
    background:white;
    color:var(--primary);
}

.github-card .primary-btn:hover{
    transform:translateY(-3px);
}

/* ===========================
   Next Project
=========================== */

.next-project{
    padding:5rem 0 6rem;
    text-align:center;
    border-top:1px solid var(--border);
}

.next-project span{
    color:var(--primary);
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    font-size:.8rem;
}

.next-project h2{
    margin:1rem 0;
    font-size:2.5rem;
}

.next-project p{
    max-width:650px;
    margin:0 auto 2rem;
    color:var(--text-light);
    line-height:1.8;
}

/* ===========================
   Buttons
=========================== */

.primary-btn,
.secondary-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.95rem 1.7rem;
    border-radius:12px;
    font-weight:600;
    text-decoration:none;
    transition:all .3s ease;
    cursor:pointer;
}

.primary-btn{
    background:var(--primary);
    color:white;
}

.primary-btn:hover{
    transform:translateY(-3px);
    box-shadow:var(--shadow-md);
}

.secondary-btn{
    border:1px solid var(--border);
    color:var(--text);
    background:var(--surface);
}

.secondary-btn:hover{
    background:var(--primary);
    color:white;
    border-color:var(--primary);
}

/* ===========================
   Animations
=========================== */

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.project-hero,
.summary,
.content-section,
.github-section,
.next-project{

    animation:fadeUp .8s ease both;

}

/* ===========================
   Responsive
=========================== */

@media (max-width:1100px){

    .pipeline{
        grid-template-columns:repeat(3,1fr);
    }

    .pipeline-arrow{
        display:none;
    }

}

@media (max-width:768px){

    .project-hero{
        padding:4rem 0;
    }

    .project-hero h1{
        font-size:2.6rem;
    }

    .summary-grid,
    .stack-grid,
    .results-grid,
    .gallery-grid{
        grid-template-columns:1fr;
    }

    .pipeline{
        grid-template-columns:1fr;
    }

    .hero-tags{
        gap:.6rem;
    }

    .github-card{
        padding:3rem 2rem;
    }

    .github-card h2{
        font-size:1.8rem;
    }

    .next-project h2{
        font-size:2rem;
    }

}

@media (max-width:480px){

    .project-page{
        padding-top:75px;
    }

    .project-hero h1{
        font-size:2.2rem;
    }

    .section-title{
        font-size:1.7rem;
    }

    .hero-subtitle{
        font-size:1rem;
    }

    .primary-btn,
    .secondary-btn{
        width:100%;
    }

}

</style>