---
import Layout from "../../layouts/Layout.astro";
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectSummary from "../../components/ProjectSummary.astro";

const project = {

    title: "Detection of Churn",

    subtitle:
        "Predicting customer churn using Machine Learning and Explainable AI.",

    category: "Machine Learning",

    domain: "SaaS",

    role: "Data Scientist",

    duration: "Personal Project",

    status: "Completed",

    technologies: [
        "Python",
        "Pandas",
        "Scikit-Learn",
        "XGBoost",
        "SHAP"
    ]

};
---

<Layout>

<main class="project-page">

    <!-- ========================= -->
    <!-- Hero -->
    <!-- ========================= -->

    <ProjectHero
        category={project.category}
        title={project.title}
        subtitle={project.subtitle}
        tags={project.technologies}
    />    

    <!-- ========================= -->
    <!-- Business Context -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>

                Business Context

            </h2>

            <p>

                Customer churn is one of the most important challenges for
                subscription-based businesses. Acquiring new customers is
                typically more expensive than retaining existing ones, making
                early churn detection a critical business capability.

            </p>

            <p>

                The objective of this project was to develop a predictive
                Machine Learning model capable of identifying customers with a
                high probability of leaving, enabling proactive retention
                strategies and data-driven decision making.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Challenge -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container narrow">

            <h2>

                Challenge

            </h2>

            <p>

                Building an accurate churn prediction model required more than
                training a classifier. The main challenge was transforming raw
                customer activity into meaningful predictive features while
                avoiding data leakage and ensuring the model could generalize
                to unseen customers.

            </p>

            <ul class="challenge-list">

                <li>Feature Engineering from user behavior.</li>

                <li>Time-aware train/test split.</li>

                <li>Class imbalance handling.</li>

                <li>Model interpretability using SHAP.</li>

                <li>Business-oriented evaluation metrics.</li>

            </ul>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Solution -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>
                Solution
            </h2>

            <p>

                The project followed a complete Machine Learning workflow,
                starting with exploratory data analysis and feature engineering
                to transform raw user activity into meaningful predictors of
                customer behavior.

            </p>

            <p>

                A time-aware validation strategy was adopted to prevent data
                leakage and simulate a real-world production scenario. Several
                classification models were evaluated, emphasizing both predictive
                performance and model interpretability.

            </p>

            <p>

                The final solution combines robust feature engineering,
                explainable machine learning techniques and business-oriented
                evaluation metrics, allowing the model to support customer
                retention decisions with transparency.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Machine Learning Pipeline -->
    <!-- ========================= -->

    <section class="pipeline-section">

        <div class="container">

            <h2 class="section-title">
                Machine Learning Pipeline
            </h2>

            <p class="section-subtitle">
                End-to-end workflow followed during the development of the project.
            </p>

            <div class="pipeline">

                <div class="pipeline-step">
                    <span>1</span>
                    <h3>Raw Data</h3>
                    <p>Customer activity, subscription and behavioral information collected over time.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>2</span>
                    <h3>Data Cleaning</h3>
                    <p>Handling missing values, duplicates and ensuring data consistency.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>3</span>
                    <h3>Feature Engineering</h3>
                    <p>Creating behavioral, temporal and aggregated customer features.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>4</span>
                    <h3>Train/Test Split</h3>
                    <p>Time-aware data splitting to preserve the chronological order of customer activity.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>5</span>
                    <h3>Model Training</h3>
                    <p>Training and comparing multiple supervised learning algorithms.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>6</span>
                    <h3>Hyperparameter Tuning</h3>
                    <p>Optimizing model performance through parameter search and cross-validation.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>7</span>
                    <h3>Model Evaluation</h3>
                    <p>Evaluating business-oriented metrics and selecting the best model.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>8</span>
                    <h3>Explainability (SHAP)</h3>
                    <p>Interpreting predictions and identifying the most influential features.</p>
                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Tech Stack -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Technology Stack
            </h2>

            <div class="stack-grid">

                <article class="stack-card">

                    <h3>Programming</h3>

                    <div class="stack-tags">

                        <span>Python</span>
                        <span>Pandas</span>
                        <span>NumPy</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Machine Learning</h3>

                    <div class="stack-tags">

                        <span>Scikit-Learn</span>
                        <span>XGBoost</span>
                        <span>SHAP</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Visualization</h3>

                    <div class="stack-tags">

                        <span>Matplotlib</span>
                        <span>Seaborn</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Development</h3>

                    <div class="stack-tags">

                        <span>Git</span>
                        <span>GitHub</span>
                        <span>Jupyter Notebook</span>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Key Results -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container">

            <h2 class="section-title">
                Key Outcomes
            </h2>

            <div class="results-grid">

                <div class="result-card">

                    <h3>Binary Classification</h3>

                    <p>

                        Customer churn prediction framed as a supervised
                        binary classification problem.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Feature Engineering</h3>

                    <p>

                        User behavior transformed into predictive variables
                        through temporal aggregations and activity indicators.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Explainable AI</h3>

                    <p>

                        SHAP values were used to explain model predictions
                        and identify the most influential features.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Business Perspective</h3>

                    <p>

                        The workflow was designed to support customer
                        retention strategies and data-driven decisions.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Visual Results -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Visual Results
            </h2>

            <p class="section-subtitle">
                Visual evidence supporting the analysis, feature interpretation
                and model evaluation.
            </p>

            <div class="gallery-grid">

                <!-- 01 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        data-image="/images/projects/churn/01-eda-inicial.png"
                        data-alt="Initial exploratory data analysis for the Detection of Churn project"
                        aria-label="View Initial Exploratory Data Analysis"
                    >

                        <img
                            src="/images/projects/churn/01-eda-inicial.png"
                            alt="Initial exploratory data analysis for the Detection of Churn project"
                            loading="lazy"
                            decoding="async"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            01
                        </span>

                        <h3>
                            Exploratory Data Analysis
                        </h3>

                        <p>
                            Initial exploration of user behavior, activity patterns
                            and variables associated with customer churn.
                        </p>

                    </div>

                </article>


                <!-- 02 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        data-image="/images/projects/churn/02-matriz-correlaciones.png"
                        data-alt="Correlation matrix showing relationships between variables in the Detection of Churn project"
                        aria-label="View Correlation Analysis"
                    >

                        <img
                            src="/images/projects/churn/02-matriz-correlaciones.png"
                            alt="Correlation matrix showing relationships between variables in the Detection of Churn project"
                            loading="lazy"
                            decoding="async"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            02
                        </span>

                        <h3>
                            Correlation Analysis
                        </h3>

                        <p>
                            Multivariate analysis of relationships between behavioral
                            variables and their relevance to churn prediction.
                        </p>

                    </div>

                </article>


                <!-- 03 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        data-image="/images/projects/churn/03-feature-importance.png"
                        data-alt="Feature importance analysis for the Detection of Churn model"
                        aria-label="View Feature Importance"
                    >

                        <img
                            src="/images/projects/churn/03-feature-importance.png"
                            alt="Feature importance analysis for the Detection of Churn model"
                            loading="lazy"
                            decoding="async"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            03
                        </span>

                        <h3>
                            Feature Importance
                        </h3>

                        <p>
                            Identification of the variables with the highest
                            contribution to the churn prediction model.
                        </p>

                    </div>

                </article>


                <!-- 04 -->
                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        data-image="/images/projects/churn/04-comparativa-modelos.png"
                        data-alt="Comparison of precision, recall and F1 score across churn prediction models"
                        aria-label="View Model Comparison"
                    >

                        <img
                            src="/images/projects/churn/04-comparativa-modelos.png"
                            alt="Comparison of precision, recall and F1 score across churn prediction models"
                            loading="lazy"
                            decoding="async"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            04
                        </span>

                        <h3>
                            Model Comparison
                        </h3>

                        <p>
                            Comparison of Precision, Recall and F1 Score across
                            Logistic Regression, Random Forest and XGBoost.
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- ========================= -->
    <!-- Image Lightbox -->
    <!-- ========================= -->

    <div
        class="image-lightbox"
        id="image-lightbox"
        aria-hidden="true"
    >

        <button
            class="lightbox-close"
            type="button"
            aria-label="Close image"
        >
            ×
        </button>

        <div class="lightbox-content">

            <img
                id="lightbox-image"
                src=""
                alt=""
            />

        </div>

    </div>


    <script>
        const galleryButtons =
            document.querySelectorAll(".gallery-image-button");

        const lightbox =
            document.getElementById("image-lightbox");

        const lightboxImage =
            document.getElementById("lightbox-image");

        const lightboxClose =
            document.querySelector(".lightbox-close");


        galleryButtons.forEach((button) => {

            button.addEventListener("click", () => {

                const image =
                    button.getAttribute("data-image");

                const alt =
                    button.getAttribute("data-alt");

                lightboxImage.src = image;
                lightboxImage.alt = alt;

                lightbox.setAttribute("aria-hidden", "false");
                lightbox.classList.add("is-open");

                document.body.classList.add("lightbox-open");

            });

        });


        function closeLightbox() {

            lightbox.classList.remove("is-open");

            lightbox.setAttribute("aria-hidden", "true");

            document.body.classList.remove("lightbox-open");

            lightboxImage.src = "";
            lightboxImage.alt = "";

        }


        lightboxClose.addEventListener(
            "click",
            closeLightbox
        );


        lightbox.addEventListener("click", (event) => {

            if (event.target === lightbox) {
                closeLightbox();
            }

        });


        document.addEventListener("keydown", (event) => {

            if (
                event.key === "Escape" &&
                lightbox.classList.contains("is-open")
            ) {
                closeLightbox();
            }

        });
    </script>

    <!-- ========================= -->
    <!-- Project Summary -->
    <!-- ========================= -->

        <ProjectSummary
        domain="SaaS / Customer Retention"
        problemType="Binary Classification"
        role="End-to-End Data Scientist"
        duration="Personal Project"
        technologies={project.technologies}
    />

    <!-- ========================= -->
    <!-- GitHub CTA -->
    <!-- ========================= -->

    <section class="github-section">

        <div class="container">

            <div class="github-card">

                <h2>
                    Explore the Source Code
                </h2>

                <p>

                    The complete implementation, notebooks and documentation
                    are available in the GitHub repository.

                </p>

                <a
                    href="https://github.com/yaninacarletti/Detection-of-Churn"
                    target="_blank"
                    class="primary-btn"
                >
                    View on GitHub →
                </a>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Next Project -->
    <!-- ========================= -->

    <section class="next-project">

        <div class="container">

            <span>
                Next Case Study
            </span>

            <h2>

                Customer Segmentation

            </h2>

            <p>

                Discover how unsupervised learning was applied to identify
                customer groups and support marketing strategies.

            </p>

            <a
                href="/projects/customer-segmentation"
                class="secondary-btn"
            >
                Read Next Project →
            </a>

        </div>

    </section>

</main>

</Layout>

<style>

.project-page{
    padding-top:90px;
}

/* ===========================
   Hero
=========================== */




/* ===========================
   Summary
=========================== */

.summary{
    padding:4rem 0;
}

.summary-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:1.2rem;
}

.summary-item{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:16px;
    padding:1.5rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.summary-item:hover{
    transform:translateY(-6px);
    box-shadow:var(--shadow-md);
}

.summary-item span{
    display:block;
    color:var(--text-light);
    font-size:.82rem;
    margin-bottom:.6rem;
}

.summary-item strong{
    font-size:1rem;
}

/* ===========================
   Generic Sections
=========================== */

.content-section{
    padding:5rem 0;
}

.alternate{
    background:var(--surface);
}

.narrow{
    max-width:820px;
}

.section-title{
    font-size:2rem;
    margin-bottom:1rem;
}

.section-subtitle{
    color:var(--text-light);
    margin-bottom:3rem;
    max-width:760px;
}

.content-section p{
    color:var(--text-light);
    line-height:1.9;
    margin-bottom:1.5rem;
}

.challenge-list{
    margin-top:2rem;
    padding-left:1.25rem;
}

.challenge-list li{
    margin-bottom:1rem;
    color:var(--text-light);
}

/* ===========================
   Pipeline
=========================== */

.pipeline{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:1rem;
    align-items:start;
    margin-top:3rem;
}

.pipeline-step{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:1.4rem;
    text-align:center;
    position:relative;
    transition:.3s;
    box-shadow:var(--shadow-sm);
}

.pipeline-step:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.pipeline-step span{
    display:inline-flex;
    width:42px;
    height:42px;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:var(--primary);
    color:white;
    font-weight:700;
    margin-bottom:1rem;
}

.pipeline-step h3{
    margin-bottom:.8rem;
    font-size:1rem;
}

.pipeline-step p{
    font-size:.92rem;
    margin:0;
}

.pipeline-arrow{
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:2rem;
    color:var(--primary);
}

/* ===========================
   Stack
=========================== */

.stack-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:1.5rem;
}

.stack-card{
    background: var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.stack-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.stack-card h3{
    margin-bottom:1.25rem;
}

.stack-tags{
    display:flex;
    flex-wrap:wrap;
    gap:.8rem;
}

.stack-tags span{
    padding:.45rem .9rem;
    border-radius:999px;
    background:rgba(99,102,241,.08);
    color:var(--primary);
    font-size:.85rem;
}

/* ===========================
   Results
=========================== */

.results-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:1.5rem;
}

.result-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.result-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.result-card h3{
    margin-bottom:1rem;
}

.result-card p{
    margin:0;
}

/* ===========================
   Gallery
=========================== */

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:2rem;
    margin-top:3rem;
}

.gallery-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--shadow-sm);
    transition:all .3s ease;
}

.gallery-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.image-placeholder{
    height:220px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(
        135deg,
        rgba(99,102,241,.08),
        rgba(99,102,241,.18)
    );
    color:var(--primary);
    font-weight:700;
    letter-spacing:.05em;
    border-bottom:1px solid var(--border);
}

.gallery-card h3{
    padding:1.5rem 1.5rem .5rem;
    margin:0;
}

.gallery-card p{
    padding:0 1.5rem 1.5rem;
    margin:0;
    color:var(--text-light);
    line-height:1.7;
}

/* ===========================
   GitHub CTA
=========================== */

.github-section{
    padding:6rem 0;
}

.github-card{
    max-width:900px;
    margin:auto;
    text-align:center;
    background:linear-gradient(
        135deg,
        var(--primary),
        #4f46e5
    );
    color:white;
    padding:4rem 3rem;
    border-radius:28px;
    box-shadow:var(--shadow-md);
}

.github-card h2{
    color:white;
    margin-bottom:1rem;
    font-size:2.2rem;
}

.github-card p{
    color:rgba(255,255,255,.88);
    max-width:650px;
    margin:0 auto 2rem;
    line-height:1.8;
}

.github-card .primary-btn{
    background:white;
    color:var(--primary);
}

.github-card .primary-btn:hover{
    transform:translateY(-3px);
}

/* ===========================
   Next Project
=========================== */

.next-project{
    padding:5rem 0 6rem;
    text-align:center;
    border-top:1px solid var(--border);
}

.next-project span{
    color:var(--primary);
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    font-size:.8rem;
}

.next-project h2{
    margin:1rem 0;
    font-size:2.5rem;
}

.next-project p{
    max-width:650px;
    margin:0 auto 2rem;
    color:var(--text-light);
    line-height:1.8;
}

/* ===========================
   Buttons
=========================== */

.primary-btn,
.secondary-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.95rem 1.7rem;
    border-radius:12px;
    font-weight:600;
    text-decoration:none;
    transition:all .3s ease;
    cursor:pointer;
}

.primary-btn{
    background:var(--primary);
    color:white;
}

.primary-btn:hover{
    transform:translateY(-3px);
    box-shadow:var(--shadow-md);
}

.secondary-btn{
    border:1px solid var(--border);
    color:var(--text);
    background:var(--surface);
}

.secondary-btn:hover{
    background:var(--primary);
    color:white;
    border-color:var(--primary);
}

/* ===========================
   Animations
=========================== */

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.project-hero,
.summary,
.content-section,
.github-section,
.next-project{

    animation:fadeUp .8s ease both;

}

/* ===========================
   Responsive
=========================== */

@media (max-width:1100px){

    .pipeline{
        grid-template-columns:repeat(3,1fr);
    }

    .pipeline-arrow{
        display:none;
    }

}

@media (max-width:768px){

    .project-hero{
        padding:4rem 0;
    }

    .project-hero h1{
        font-size:2.6rem;
    }

    .summary-grid,
    .stack-grid,
    .results-grid,
    .gallery-grid{
        grid-template-columns:1fr;
    }

    .pipeline{
        grid-template-columns:1fr;
    }

    .hero-tags{
        gap:.6rem;
    }

    .github-card{
        padding:3rem 2rem;
    }

    .github-card h2{
        font-size:1.8rem;
    }

    .next-project h2{
        font-size:2rem;
    }

}

@media (max-width:480px){

    .project-page{
        padding-top:75px;
    }

    .project-hero h1{
        font-size:2.2rem;
    }

    .section-title{
        font-size:1.7rem;
    }

    .hero-subtitle{
        font-size:1rem;
    }

    .primary-btn,
    .secondary-btn{
        width:100%;
    }

}

/* ========================= */
/* Visual Results Gallery */
/* ========================= */

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}


.gallery-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}


.gallery-card:hover {
    transform: translateY(-4px);
