---
import Layout from "../../layouts/Layout.astro";
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectSummary from "../../components/ProjectSummary.astro";

const project = {

    title: "Data Quality",

    subtitle:
       "Building automated data validation and monitoring workflows to ensure reliable analytics.",

    category: "Data Engineering",

    domain: "SaaS",

    role: "Data Scientist",

    duration: "Personal Project",

    status: "Completed",

    technologies: [
        "Python",
        "SQL",
        "Pandas",
        "Data Validation",
        "Data Profiling",
        "Great Expectations"
    ]

};
---

<Layout>

<main class="project-page">

    <!-- ========================= -->
    <!-- Hero -->
    <!-- ========================= -->

    <ProjectHero
        category={project.category}
        title={project.title}
        subtitle={project.subtitle}
        tags={project.technologies}
    />    

    <!-- ========================= -->
    <!-- Business Context -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>

                Business Context

            </h2>

            <p>

                Business decisions are only as reliable as the quality of the
                underlying data. Inconsistent, incomplete or duplicated records
                can lead to incorrect analyses, unreliable dashboards and poor
                operational decisions.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Challenge -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container narrow">

            <h2>

                Challenge

            </h2>

            <p>

                The objective was to automatically detect common data quality
                issues such as missing values, duplicates, invalid formats,
                inconsistent business rules and unexpected anomalies before the
                data reached analytical environments.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Solution -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container narrow">

            <h2>
                Solution
            </h2>

            <p>

                An automated validation workflow was designed to profile datasets,
                execute quality checks, generate validation reports and notify
                potential data issues before downstream analytical processes.

            </p>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Data Quality Pipeline -->
    <!-- ========================= -->

    <section class="pipeline-section">

        <div class="container">

            <h2 class="section-title">
                Data Quality Pipeline
            </h2>

            <p class="section-subtitle">
                End-to-end workflow followed during the development of the project.
            </p>

            <div class="pipeline">

                <div class="pipeline-step">
                    <span>1</span>
                    <h3>Raw Data</h3>
                    <p>Incoming datasets from operational systems.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>2</span>
                    <h3>Profiling</h3>
                    <p>Exploring distributions, completeness and data types.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>3</span>
                    <h3>Validation Rules</h3>
                    <p>Applying business and technical validation checks.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>4</span>
                    <h3>Missing Values</h3>
                    <p>Detecting incomplete information.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>5</span>
                    <h3>Duplicate Detection</h3>
                    <p>Identifying duplicated records.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>6</span>
                    <h3>Anomaly Detection</h3>
                    <p>Discovering unexpected values and inconsistencies.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>7</span>
                    <h3>Reporting</h3>
                    <p>Generating quality reports and validation summaries.</p>
                </div>

                <div class="pipeline-arrow">→</div>

                <div class="pipeline-step">
                    <span>8</span>
                    <h3>Monitoring</h3>
                    <p>Continuous monitoring of data quality indicators.</p>
                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Tech Stack -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Technology Stack
            </h2>

            <div class="stack-grid">

                <article class="stack-card">

                    <h3>Programming</h3>

                    <div class="stack-tags">

                        <span>Python</span>
                        <span>Pandas</span>
                        <span>SQL</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Data Quality</h3>

                    <div class="stack-tags">

                        <span>Great Expectations</span>
                        <span>Data Profiling</span>
                        <span>Validation Rules</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Visualization</h3>

                    <div class="stack-tags">

                        <span>Matplotlib</span>
                        <span>Seaborn</span>

                    </div>

                </article>

                <article class="stack-card">

                    <h3>Development</h3>

                    <div class="stack-tags">

                        <span>Git</span>
                        <span>GitHub</span>
                        <span>Jupyter Notebook</span>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Key Outcomes -->
    <!-- ========================= -->

    <section class="content-section">

        <div class="container">

            <h2 class="section-title">
                Key Outcomes
            </h2>

            <div class="results-grid">

                <div class="result-card">

                    <h3>Automated Validation</h3>

                    <p>

                        Automated validation rules ensuring consistent and reliable
                        datasets.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Data Profiling</h3>

                    <p>

                        Exploratory profiling used to understand data completeness,
                        distributions and quality indicators.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Quality Monitoring</h3>

                    <p>

                        Continuous monitoring of quality metrics to detect issues
                        before they affect analytical processes.

                    </p>

                </div>

                <div class="result-card">

                    <h3>Reliable Analytics</h3>

                    <p>

                        Validation workflows improving confidence in dashboards,
                        reports and business decision-making.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Visual Results -->
    <!-- ========================= -->

    <section class="content-section alternate">

        <div class="container">

            <h2 class="section-title">
                Visual Results
            </h2>

            <p class="section-subtitle">
                Visual evidence of the data quality analysis,
                outlier treatment, and feature selection process.
            </p>

            <div class="gallery-grid">

                <!-- 01 -->

                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Initial Exploratory Data Analysis image"
                        data-lightbox-image="/images/projects/data-quality/01-eda-inicial.png"
                        data-lightbox-alt="Initial exploratory data analysis of the dataset"
                    >

                        <img
                            src="/images/projects/data-quality/01-eda-inicial.png"
                            alt="Initial exploratory data analysis of the dataset"
                            loading="lazy"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            01
                        </span>

                        <h3>
                            Initial Exploratory Data Analysis
                        </h3>

                        <p>
                            Initial exploration of the dataset to understand
                            variable distributions, data behavior, and potential
                            quality issues.
                        </p>

                    </div>

                </article>


                <!-- 02 -->

                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Outlier Analysis image"
                        data-lightbox-image="/images/projects/data-quality/02-boxplots-outliers.png"
                        data-lightbox-alt="Boxplots used to identify potential outliers in numerical variables"
                    >

                        <img
                            src="/images/projects/data-quality/02-boxplots-outliers.png"
                            alt="Boxplots used to identify potential outliers in numerical variables"
                            loading="lazy"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            02
                        </span>

                        <h3>
                            Outlier Analysis
                        </h3>

                        <p>
                            Boxplot-based analysis used to identify potential
                            outliers and assess their impact on the dataset.
                        </p>

                    </div>

                </article>


                <!-- 03 -->

                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Outlier Removal Results image"
                        data-lightbox-image="/images/projects/data-quality/03-outliers-removed.png"
                        data-lightbox-alt="Data visualization after the removal of identified outliers"
                    >

                        <img
                            src="/images/projects/data-quality/03-outliers-removed.png"
                            alt="Data visualization after the removal of identified outliers"
                            loading="lazy"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            03
                        </span>

                        <h3>
                            Outlier Treatment
                        </h3>

                        <p>
                            Visualization after outlier removal, showing the
                            resulting data distributions following the cleaning stage.
                        </p>

                    </div>

                </article>


                <!-- 04 -->

                <article class="gallery-card">

                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label="View Feature Selection image"
                        data-lightbox-image="/images/projects/data-quality/04-feature-selection.png"
                        data-lightbox-alt="Feature selection analysis using correlations, forward selection, and Lasso"
                    >

                        <img
                            src="/images/projects/data-quality/04-feature-selection.png"
                            alt="Feature selection analysis using correlations, forward selection, and Lasso"
                            loading="lazy"
                        />

                    </button>

                    <div class="gallery-content">

                        <span class="gallery-number">
                            04
                        </span>

                        <h3>
                            Feature Selection
                        </h3>

                        <p>
                            Feature selection analysis combining correlation-based
                            methods, Forward Selection, and Lasso regularization.
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Image Lightbox -->
    <!-- ========================= -->

    <div
        id="image-lightbox"
        class="image-lightbox"
        aria-hidden="true"
    >
        <div class="lightbox-content">

            <button
                class="lightbox-close"
                type="button"
                aria-label="Close image"
            >
                ×
            </button>

            <img
                id="lightbox-image"
                src=""
                alt=""
            />

        </div>
    </div>

    <script>
        const lightbox = document.getElementById('image-lightbox');
        const lightboxImage = document.getElementById('lightbox-image');
        const lightboxClose = document.querySelector('.lightbox-close');
        const galleryButtons = document.querySelectorAll('.gallery-image-button');

        function openLightbox(imageSrc, imageAlt) {
            if (!lightbox || !lightboxImage) return;

            lightboxImage.src = imageSrc;
            lightboxImage.alt = imageAlt;

            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden', 'false');

            document.body.classList.add('lightbox-open');
        }

        function closeLightbox() {
            if (!lightbox || !lightboxImage) return;

            lightbox.classList.remove('is-open');
            lightbox.setAttribute('aria-hidden', 'true');

            document.body.classList.remove('lightbox-open');

            lightboxImage.src = '';
            lightboxImage.alt = '';
        }

        galleryButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const imageSrc = button.getAttribute('data-lightbox-image');
                const imageAlt = button.getAttribute('data-lightbox-alt');

                if (imageSrc && imageAlt) {
                    openLightbox(imageSrc, imageAlt);
                }
            });
        });

        lightboxClose?.addEventListener('click', closeLightbox);

        lightbox?.addEventListener('click', (event) => {
            if (event.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>

    <!-- ========================= -->
    <!-- Project Summary -->
    <!-- ========================= -->

        <ProjectSummary
        domain="Data Governance"
        problemType="Data Quality"
        role="Data Engineer"
        duration="Personal Project"
        technologies={project.technologies}
    />

    <!-- ========================= -->
    <!-- GitHub CTA -->
    <!-- ========================= -->

    <section class="github-section">

        <div class="container">

            <div class="github-card">

                <h2>
                    Explore the Complete Project
                </h2>

                <p>

                    Discover the validation framework, data quality rules and monitoring workflow implemented in this project.

                </p>

                <a
                    href="https://github.com/yaninacarletti/Data-Quality---Feature-Engineering-and-Selection"
                    target="_blank"
                    class="primary-btn"
                >
                    View on GitHub →
                </a>

            </div>

        </div>

    </section>

    <!-- ========================= -->
    <!-- Next Project -->
    <!-- ========================= -->

    <section class="next-project">

        <div class="container">

            <h2>

                Back to Portfolio

            </h2>

            <p>

                Explore the complete portfolio, discover additional projects and learn more about my experience.

            </p>

            <a
                href="/"
                class="secondary-btn"
            >
                Return to Home →
            </a>

        </div>

    </section>

</main>

</Layout>

<style>

.project-page{
    padding-top:90px;
}

/* ===========================
   Hero
=========================== */




/* ===========================
   Summary
=========================== */

.summary{
    padding:4rem 0;
}

.summary-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:1.2rem;
}

.summary-item{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:16px;
    padding:1.5rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.summary-item:hover{
    transform:translateY(-6px);
    box-shadow:var(--shadow-md);
}

.summary-item span{
    display:block;
    color:var(--text-light);
    font-size:.82rem;
    margin-bottom:.6rem;
}

.summary-item strong{
    font-size:1rem;
}

/* ===========================
   Generic Sections
=========================== */

.content-section{
    padding:5rem 0;
}

.alternate{
    background:var(--surface);
}

.narrow{
    max-width:820px;
}

.section-title{
    font-size:2rem;
    margin-bottom:1rem;
}

.section-subtitle{
    color:var(--text-light);
    margin-bottom:3rem;
    max-width:760px;
}

.content-section p{
    color:var(--text-light);
    line-height:1.9;
    margin-bottom:1.5rem;
}

.challenge-list{
    margin-top:2rem;
    padding-left:1.25rem;
}

.challenge-list li{
    margin-bottom:1rem;
    color:var(--text-light);
}

/* ===========================
   Pipeline
=========================== */

.pipeline{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:1rem;
    align-items:start;
    margin-top:3rem;
}

.pipeline-step{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:1.4rem;
    text-align:center;
    position:relative;
    transition:.3s;
    box-shadow:var(--shadow-sm);
}

.pipeline-step:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.pipeline-step span{
    display:inline-flex;
    width:42px;
    height:42px;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:var(--primary);
    color:white;
    font-weight:700;
    margin-bottom:1rem;
}

.pipeline-step h3{
    margin-bottom:.8rem;
    font-size:1rem;
}

.pipeline-step p{
    font-size:.92rem;
    margin:0;
}

.pipeline-arrow{
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:2rem;
    color:var(--primary);
}

/* ===========================
   Stack
=========================== */

.stack-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:1.5rem;
}

.stack-card{
    background: var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.stack-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.stack-card h3{
    margin-bottom:1.25rem;
}

.stack-tags{
    display:flex;
    flex-wrap:wrap;
    gap:.8rem;
}

.stack-tags span{
    padding:.45rem .9rem;
    border-radius:999px;
    background:var(--surface);
    border:1px solid var(--border);
    color:var(--primary);
    font-size:.85rem;
}

/* ===========================
   Results
=========================== */

.results-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:1.5rem;
}

.result-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:18px;
    padding:2rem;
    box-shadow:var(--shadow-sm);
    transition:.3s;
}

.result-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.result-card h3{
    margin-bottom:1rem;
}

.result-card p{
    margin:0;
}

/* ===========================
   Gallery
=========================== */

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:2rem;
    margin-top:3rem;
}

.gallery-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--shadow-sm);
    transition:all .3s ease;
}

.gallery-card:hover{
    transform:translateY(-8px);
    box-shadow:var(--shadow-md);
}

.gallery-image-button{
    display:block;
    width:100%;
    padding:0;
    margin:0;
    border:0;
    background:var(--surface);
    cursor:pointer;
    overflow:hidden;
}

.gallery-image-button img{
    display:block;
    width:100%;
    height:300px;
    object-fit:contain;
    background:var(--surface);
    transition:transform .35s ease;
}

.gallery-image-button:hover img{
    transform:scale(1.025);
}

.gallery-content{
    padding:1.5rem;
}

.gallery-number{
    display:block;
    margin-bottom:1.5rem;
    color:var(--primary);
    font-size:.8rem;
    font-weight:700;
    letter-spacing:.08em;
}

.gallery-content h3{
    margin:0 0 .75rem;
    font-size:1.05rem;
}

.gallery-content p{
    margin:0;
    color:var(--text-light);
    line-height:1.7;
}

/* ===========================
   Lightbox
=========================== */

.image-lightbox{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:2rem;
    background:rgba(0,0,0,.88);
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    transition:opacity .3s ease, visibility .3s ease;
}

.image-lightbox.is-open{
    opacity:1;
    visibility:visible;
    pointer-events:auto;
}

.lightbox-content{
    position:relative;
    max-width:95vw;
    max-height:90vh;
    display:flex;
    align-items:center;
    justify-content:center;
}

.lightbox-content img{
    display:block;
    max-width:95vw;
    max-height:90vh;
    width:auto;
    height:auto;
    object-fit:contain;
    border-radius:12px;
    box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.lightbox-close{
    position:fixed;
    top:1.5rem;
    right:1.5rem;
    z-index:10000;
    width:44px;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(255,255,255,.35);
    border-radius:50%;
    background:rgba(255,255,255,.1);
    color:white;
    font-size:1.8rem;
    line-height:1;
    cursor:pointer;
    transition:all .25s ease;
}

.lightbox-close:hover{
    background:white;
    color:var(--primary);
}

body.lightbox-open{
    overflow:hidden;
}

/* ===========================
   Gallery Responsive
=========================== */

@media (max-width:768px){

    .gallery-grid{
        grid-template-columns:1fr;
    }

    .gallery-image-button img{
        height:260px;
    }

    .gallery-content{
        padding:1.35rem;
    }

    .image-lightbox{
        padding:1rem;
    }

    .lightbox-content img{
        max-width:94vw;
        max-height:82vh;
    }

    .lightbox-close{
        top:1rem;
        right:1rem;
    }

}

/* ===========================
   GitHub CTA
=========================== */

.github-section{
    padding:6rem 0;
}

.github-card{
    max-width:900px;
    margin:auto;
    text-align:center;
    background:linear-gradient(
        135deg,
        var(--primary),
        #4f46e5
    );
    color:white;
    padding:4rem 3rem;
    border-radius:28px;
    box-shadow:var(--shadow-md);
}

.github-card h2{
    color:white;
    margin-bottom:1rem;
    font-size:2.2rem;
}

.github-card p{
    color:rgba(255,255,255,.88);
    max-width:650px;
    margin:0 auto 2rem;
    line-height:1.8;
}

.github-card .primary-btn{
    background:white;
    color:var(--primary);
}

.github-card .primary-btn:hover{
    transform:translateY(-3px);
}

/* ===========================
   Next Project
=========================== */

.next-project{
    padding:5rem 0 6rem;
    text-align:center;
    border-top:1px solid var(--border);
}

.next-project span{
    color:var(--primary);
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    font-size:.8rem;
}

.next-project h2{
    margin:1rem 0;
    font-size:2.5rem;
}

.next-project p{
    max-width:650px;
    margin:0 auto 2rem;
    color:var(--text-light);
    line-height:1.8;
}

/* ===========================
   Buttons
=========================== */

.primary-btn,
.secondary-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.95rem 1.7rem;
    border-radius:12px;
    font-weight:600;
    text-decoration:none;
    transition:all .3s ease;
    cursor:pointer;
}

.primary-btn{
    background:var(--primary);
    color:white;
}

.primary-btn:hover{
    transform:translateY(-3px);
    box-shadow:var(--shadow-md);
}

.secondary-btn{
    border:1px solid var(--border);
    color:var(--text);
    background:var(--surface);
}

.secondary-btn:hover{
    background:var(--primary);
    color:white;
    border-color:var(--primary);
}

/* ===========================
   Animations
=========================== */

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.project-hero,
.summary,
.content-section,
.github-section,
.next-project{

    animation:fadeUp .8s ease both;

}

/* ===========================
   Responsive
=========================== */

@media (max-width:1100px){

    .pipeline{
        grid-template-columns:repeat(3,1fr);
    }

    .pipeline-arrow{
        display:none;
    }

}

@media (max-width:768px){

