---
interface Props {
    title: string;
    href: string;
    label?: string;
}

const {
    title,
    href,
    label = "Next Case Study"
} = Astro.props;
---

<section class="next-project">

    <a
        href={href}
        class="next-card"
    >

        <div>

            <span class="eyebrow">

                {label}

            </span>

            <h2>

                {title}

            </h2>

        </div>

        <span class="arrow">

            →

        </span>

    </a>

</section>

<style>

.next-project{

    margin:5rem 0 2rem;

}

.next-card{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:2rem;

    text-decoration:none;

    padding:2rem;

    border-radius:24px;

    border:1px solid var(--border);

    background:var(--surface);

    box-shadow:var(--shadow-sm);

    transition:all .3s ease;

}

.next-card:hover{

    transform:translateY(-5px);

    box-shadow:var(--shadow-md);

    border-color:var(--primary);

}

.eyebrow{

    display:block;

    color:var(--primary);

    font-size:.9rem;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.08em;

    margin-bottom:.6rem;

}

.next-card h2{

    margin:0;

    color:var(--text);

    font-size:clamp(1.4rem,3vw,2rem);

    line-height:1.2;

}

.arrow{

    font-size:2.5rem;

    color:var(--primary);

    transition:transform .25s ease;

}

.next-card:hover .arrow{

    transform:translateX(8px);

}

@media(max-width:768px){

    .next-card{

        flex-direction:column;

        align-items:flex-start;

    }

    .arrow{

        align-self:flex-end;

    }

}

</style>
